{
    "workbench.colorTheme": "Catppuccin Macchiato",
    "workbench.iconTheme": "catppuccin-macchiato",
    "git.autofetch": true,
    "makefile.configureOnOpen": true,
    "mesonbuild.downloadLanguageServer": true,
    "terminal.integrated.fontFamily": "Hack Nerd Font",
    "clangd.checkUpdates": true,
    "clangd.inactiveRegions.useBackgroundHighlight": true,
    "git.confirmSync": false,
    "clangd.path": "/home/xgui4/.config/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/21.1.8/clangd_21.1.8/bin/clangd",
    "git.enableSmartCommit": true,
    "mesonbuild.buildFolder": "build",
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-5.15.18-linux-g++_from_PATH",
            "path": "/usr/bin/qmake"
        },
        {
            "name": "Qt-5.15.18-linux-g++_from_PATH",
            "path": "/usr/bin/qtpaths"
        }
    ],
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "qt-qml.qmlls.traceLsp": "messages",
    "qt-qml.qmlls.verboseOutput": true,
    "qt-qml.doNotAskForQmllsDownload": true,
    "qt-qml.qmlls.customExePath": "/usr/bin/qmlls6",
    "zig.zls.enabled": "on",
    "qt-core.defaultProjectDirectory": "/home/xgui4/develop/anime-fetch",
    "qt-cpp.doNotShowCMakePresetWarning": true,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "redhat.telemetry.enabled": false,
    "editor.fontFamily": "'Hack Nerd Font', monospace",
    "python.createEnvironment.trigger": "off",
    "git.replaceTagsWhenPull": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "files.associations": {
        "*.lce_inst": "json"
    },
    "json.schemaDownload.trustedDomains": {
        "https://raw.githubusercontent.com/xgui4/": true
    },
    "security.workspace.trust.untrustedFiles": "open"
}